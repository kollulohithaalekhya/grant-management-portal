# ---------------------------------------------------------------------------
# Secure Grant Management Portal — environment template
# Copy to `.env` (`cp .env.example .env`) and fill in real values.
# docker-compose.yml reads this file automatically.
# ---------------------------------------------------------------------------

# --- Database -------------------------------------------------------------
# Connection string used by Prisma. When running through docker-compose the
# host must be `postgres` (the service name); use `localhost` when running the
# API directly on your machine.
DATABASE_URL=postgresql://grant:grant_password@postgres:5432/grant_portal?schema=public

# Credentials the postgres container is initialised with. Keep them in sync
# with DATABASE_URL.
POSTGRES_USER=grant
POSTGRES_PASSWORD=grant_password
POSTGRES_DB=grant_portal
POSTGRES_PORT=5432

# --- Redis ----------------------------------------------------------------
# Used for OAuth state (CSRF) storage and the revoked access-token denylist.
REDIS_URL=redis://redis:6379
REDIS_PORT=6379

# --- JWT ------------------------------------------------------------------
# Generate with: openssl rand -hex 48
JWT_SECRET=change-me-to-a-long-random-string
JWT_REFRESH_SECRET=change-me-to-a-different-long-random-string
JWT_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# --- Google OAuth 2.0 -----------------------------------------------------
# From https://console.cloud.google.com/apis/credentials (OAuth client ID,
# type "Web application"). The redirect URI below must be registered there.
OAUTH_CLIENT_ID=your-google-oauth-client-id
OAUTH_CLIENT_SECRET=your-google-oauth-client-secret
OAUTH_REDIRECT_URI=http://localhost:5000/api/auth/google/callback

# --- Application ----------------------------------------------------------
NODE_ENV=development
PORT=5000
API_PORT=5000
WEB_PORT=8080
# Frontend origin: used for CORS and as the target of the post-OAuth redirect.
# Through docker-compose the SPA is served by the `web` container on WEB_PORT.
# Change this to http://localhost:5173 if you run `npm run dev` in frontend/.
CLIENT_URL=http://localhost:8080
