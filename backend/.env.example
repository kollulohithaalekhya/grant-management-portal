# ---------------------------------------------------------------------------
# Backend environment template — for running the API directly on your machine
# (`npm run dev`). When running through docker-compose, the root .env is used
# instead and these values are injected by compose.
#
#   cp .env.example .env
# ---------------------------------------------------------------------------

NODE_ENV=development
PORT=5000

# PostgreSQL (host `localhost` because the API runs outside the compose network)
DATABASE_URL=postgresql://grant:grant_password@localhost:5432/grant_portal?schema=public

# Redis — optional locally. If unset, an equivalent in-process store is used
# for OAuth state and the revoked-token denylist.
REDIS_URL=redis://localhost:6379

# JWT — generate with: openssl rand -hex 48
JWT_SECRET=change-me-to-a-long-random-string
JWT_REFRESH_SECRET=change-me-to-a-different-long-random-string
JWT_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# Google OAuth 2.0 — https://console.cloud.google.com/apis/credentials
OAUTH_CLIENT_ID=your-google-oauth-client-id
OAUTH_CLIENT_SECRET=your-google-oauth-client-secret
OAUTH_REDIRECT_URI=http://localhost:5000/api/auth/google/callback

# Frontend origin — used for CORS and the post-OAuth redirect
CLIENT_URL=http://localhost:5173
