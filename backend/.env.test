# Environment used by `npm test` / `npm run test:coverage`.
# Committed on purpose: it contains no real secrets and lets the suite run
# with a single `docker compose up -d postgres`.
#
# The suite DROPS AND RECREATES this database on every run — never point it at
# a database you care about.

NODE_ENV=test
DATABASE_URL=postgresql://grant:grant_password@localhost:5432/grant_portal_test?schema=public

JWT_SECRET=test-access-secret-do-not-use-outside-tests
JWT_REFRESH_SECRET=test-refresh-secret-do-not-use-outside-tests
JWT_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

OAUTH_CLIENT_ID=test-google-client-id
OAUTH_CLIENT_SECRET=test-google-client-secret
OAUTH_REDIRECT_URI=http://localhost:5000/api/auth/google/callback

CLIENT_URL=http://localhost:5173

# Deliberately blank: the in-process store backs OAuth state and the token
# denylist during tests, so no Redis container is required. It must be set to
# an empty value (not omitted) so it also overrides a REDIS_URL coming from
# .env or the shell — a live Redis connection would keep Jest from exiting.
REDIS_URL=
